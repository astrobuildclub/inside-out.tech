---
// Kaart voor een item uit een collectie: project, nieuws, module of teamlid.
import { stegaClean } from "@sanity/client/stega";
import SanityImg from "./SanityImg.astro";
import Icon from "./Icon.astro";
import { hrefFor } from "../lib/sanity/routes";
import type { CardItem } from "../lib/sanity/queries";

interface Props { item: CardItem; sizes?: string; headingLevel?: "h2" | "h3" }
const { item, sizes = "(min-width: 62rem) 30vw, (min-width: 40rem) 45vw, 90vw", headingLevel: H = "h3" } = Astro.props;
const type = stegaClean(item._type);
const href = hrefFor(type, stegaClean(item.slug));
const date = item.publishedAt
  ? new Intl.DateTimeFormat("nl-NL", { day: "numeric", month: "long", year: "numeric" }).format(new Date(stegaClean(item.publishedAt)))
  : undefined;
---
{type === "person" ? (
  <article class="item person">
    <div class="media"><SanityImg image={item.image} {sizes} aspect={4 / 5} /></div>
    <div class="body">
      <H class="title">{item.title}</H>
      {item.role && <p class="meta">{item.role}</p>}
      <p class="links">
        {item.email && <a href={`mailto:${stegaClean(item.email)}`}><Icon name="mail" /><span class="visually-hidden">E-mail {item.title}</span></a>}
        {item.linkedin && <a href={stegaClean(item.linkedin)} target="_blank" rel="noopener"><Icon name="linkedin" /><span class="visually-hidden">{item.title} op LinkedIn (opent in nieuw venster)</span></a>}
      </p>
    </div>
  </article>
) : (
  <article class="item">
    <div class="media"><SanityImg image={item.image} {sizes} aspect={type === "module" ? 1 : 4 / 3} /></div>
    <div class="body">
      {(item.address || item.type || date) && <p class="meta">{item.address ?? item.type ?? (date && <time datetime={stegaClean(item.publishedAt)}>{date}</time>)}</p>}
      <H class="title"><a href={href}>{item.title}</a></H>
      {(item.excerpt || item.intro) && <p class="excerpt">{item.excerpt ?? item.intro}</p>}
      <span class="more" aria-hidden="true">Lees meer <Icon name="arrow" /></span>
    </div>
  </article>
)}

<style>
  .item {
    position: relative;
    display: grid; grid-template-rows: auto 1fr;
    block-size: 100%;
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
  }
  .media { aspect-ratio: 4 / 3; background: var(--color-line); overflow: hidden; }
  .person .media { aspect-ratio: 4 / 5; }
  .media :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: scale 600ms var(--ease); }
  .item:not(.person):hover .media :global(img) { scale: 1.04; }
  .body { display: grid; gap: var(--space-2xs); align-content: start; padding: var(--space-s) var(--space-m) var(--space-m); }
  .meta { font-size: var(--step--1); color: var(--color-accent); font-weight: 500; }
  .title { font-size: var(--step-1); line-height: var(--leading-snug); letter-spacing: 0; }
  .title a { text-decoration: none; }
  /* Hele kaart klikbaar, link blijft de echte titel-link */
  .title a::after { content: ""; position: absolute; inset: 0; }
  .title a:focus-visible { outline: none; }
  .item:has(.title a:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .excerpt { font-size: var(--step--1); color: var(--color-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .more { display: inline-flex; gap: 0.4em; align-items: center; margin-block-start: var(--space-2xs); font-size: var(--step--1); font-weight: 500; }
  .more :global(svg) { inline-size: 1em; block-size: 1em; transition: translate var(--duration) var(--ease); }
  .item:hover .more :global(svg) { translate: 3px 0; }
  .links { display: flex; gap: var(--space-2xs); margin-block-start: var(--space-2xs); }
  .links a { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; border-radius: var(--radius-pill); background: var(--lemon); color: var(--planet); }
  .links :global(svg) { inline-size: 1.1rem; block-size: 1.1rem; }
</style>
