---
// Beelden van een project, module of nieuwsbericht als carousel, met bijschrift.
import Carousel from "./Carousel.astro";
import SanityImg from "./SanityImg.astro";
import type { SanityImage } from "../lib/sanity/image";
interface Props { media?: SanityImage[] | null; label: string }
const { media, label } = Astro.props;
const items = (media ?? []).filter((m) => m?.asset);
---
{items.length > 0 && (
  <section class="section gallery" data-tone="white" aria-label={label}>
    <div class="wrapper">
      <Carousel {label} itemWidth="min(85vw, 56rem)" controls="bottom">
        {items.map((image) => (
          <li>
            <figure>
              <div class="media-frame"><SanityImg {image} sizes="(min-width: 62rem) 56rem, 85vw" aspect={4 / 3} /></div>
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </Carousel>
    </div>
  </section>
)}

<style>
  .gallery { padding-block-start: 0; }
  .media-frame { aspect-ratio: 4 / 3; }
  figcaption { margin-block-start: var(--space-2xs); font-size: var(--step--1); color: var(--color-muted); }
</style>
