---
// Horizontale carousel op basis van scroll-snap (vervangt Owl Carousel + jQuery).
// Werkt zonder JS (swipen/scrollen); de knoppen scrollen één kaart per klik.
import Icon from "./Icon.astro";
interface Props { label: string; itemWidth?: string; controls?: "top" | "bottom" }
const { label, itemWidth = "clamp(16rem, 30vw, 26rem)", controls = "top" } = Astro.props;
---
<div class:list={["carousel", `controls-${controls}`]} data-carousel style={`--item-width: ${itemWidth}`}>
  <div class="controls">
    <button type="button" data-prev disabled><Icon name="arrow-left" /><span class="visually-hidden">Vorige</span></button>
    <button type="button" data-next><Icon name="arrow" /><span class="visually-hidden">Volgende</span></button>
    <p class="count" data-count aria-hidden="true"></p>
  </div>
  <ul role="list" class="track" data-track aria-label={label} tabindex="0">
    <slot />
  </ul>
</div>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
      const track = root.querySelector<HTMLElement>("[data-track]")!;
      const prev = root.querySelector<HTMLButtonElement>("[data-prev]")!;
      const next = root.querySelector<HTMLButtonElement>("[data-next]")!;
      const count = root.querySelector<HTMLElement>("[data-count]")!;
      const items = [...track.children] as HTMLElement[];
      const step = () => (track.firstElementChild as HTMLElement | null)?.offsetWidth ?? track.clientWidth;
      const update = () => {
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        root.toggleAttribute("data-static", prev.disabled && next.disabled);
        // Positie (visueel; de knoppen hebben hun eigen labels): "1–3 / 7" voor de volledig zichtbare kaarten
        const box = track.getBoundingClientRect();
        const shown = items.flatMap((el, i) => {
          const r = el.getBoundingClientRect();
          return r.left >= box.left - 2 && r.right <= box.right + 2 ? [i + 1] : [];
        });
        if (shown.length) {
          const first = shown[0], last = shown[shown.length - 1];
          count.textContent = `${first === last ? first : `${first}–${last}`} / ${items.length}`;
        }
      };
      prev.onclick = () => track.scrollBy({ left: -step(), behavior: "smooth" });
      next.onclick = () => track.scrollBy({ left: step(), behavior: "smooth" });
      track.addEventListener("scroll", update, { passive: true });
      new ResizeObserver(update).observe(track);
      update();
    });
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .carousel { display: grid; gap: var(--space-s); }
  .controls { display: flex; gap: var(--space-2xs); justify-content: flex-end; }
  .controls-bottom .controls { order: 1; justify-content: flex-start; }
  .count { align-self: center; margin-inline-start: var(--space-2xs); font-size: var(--step--1); font-variant-numeric: tabular-nums; color: var(--color-muted); }
  .count:empty { display: none; }
  .carousel[data-static] .controls { display: none; }
  .controls button {
    display: grid; place-items: center;
    inline-size: 2.75rem; block-size: 2.75rem;
    border: 0; border-radius: var(--radius-pill);
    background: var(--planet); color: var(--white);
    cursor: pointer;
  }
  .controls button:disabled { opacity: 0.35; cursor: default; }
  .controls svg { inline-size: 1.1rem; block-size: 1.1rem; }
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--item-width);
    align-items: start; /* kaarten niet oprekken tot de langste: geen lege ruimte boven de knoppen */
    gap: var(--space-m);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block-end: 2px;
  }
  .track::-webkit-scrollbar { display: none; }
  .track > :global(*) { scroll-snap-align: start; }
  @media (prefers-reduced-motion: no-preference) { .track { scroll-behavior: smooth; } }
</style>
