---
// Paginakop. "stacked": titel met intro eronder; "split": titel links, intro rechts (live: Plug & Play, Projecten, Nieuws).
// Met beeld: foto als achtergrond met groene verloop-overlay, titel onderin (live: Over ons, projectdetail).
import { stegaClean } from "@sanity/client/stega";
import Section from "./Section.astro";
import SanityImg from "../SanityImg.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import type { Section as S } from "../../lib/sanity/queries";

type Props = Extract<S, { _type: "pageHeader" }> & { breadcrumbs?: { label: string; href?: string }[] };
const { eyebrow, title, intro, image, theme = "green", breadcrumbs, layout } = Astro.props;
const split = stegaClean(layout) === "split" && !image?.asset;
// Korte titels ("contact", "Projecten") groot zoals live; lange titels een stap kleiner.
const short = stegaClean(title).length <= 24;
---
<Section theme={image?.asset ? "green" : theme} class:list={["page-header", { "has-image": image?.asset, split, short }]}>
  {image?.asset && <div class="bg"><SanityImg {image} sizes="100vw" priority alt="" /></div>}
  <div class="wrapper inner">
    <div class="titles">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {breadcrumbs?.length ? <Breadcrumbs items={breadcrumbs} class="crumbs" /> : null}
    </div>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</Section>

<style>
  :global(.page-header) { position: relative; isolation: isolate; padding-block: var(--space-2xl) var(--space-xl); }
  :global(.page-header.has-image) { min-block-size: 20rem; display: grid; align-items: end; }
  @media (min-width: 62rem) { :global(.page-header.has-image) { min-block-size: 480px; } }
  .bg { position: absolute; inset: 0; z-index: -1; }
  .bg :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  /* Neutrale donkere waas over de foto (live), onderin iets sterker voor de titel */
  .bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, oklch(0% 0 0 / 0.55), oklch(0% 0 0 / 0.3) 50%, oklch(0% 0 0 / 0.2)); }
  .inner { display: grid; gap: var(--space-s); }
  .titles { display: grid; gap: var(--space-2xs); }
  h1 { font-size: var(--step-4); max-inline-size: 24ch; }
  :global(.page-header.short) h1, :global(.page-header.has-image) h1 { font-size: var(--step-5); }
  .eyebrow { color: var(--color-accent); text-transform: none; letter-spacing: 0; }
  .intro { color: var(--color-fg); font-size: var(--step-0); line-height: var(--leading-normal); max-inline-size: 48ch; }
  /* Intro onder een korte titel (contact): groter, zoals live */
  :global(.page-header.short:not(.split)) .intro { font-size: var(--step-1); line-height: var(--leading-lead); }
  @media (min-width: 62rem) {
    :global(.page-header.split) .inner { grid-template-columns: 1fr minmax(0, 32rem); align-items: start; gap: var(--space-xl); }
  }
  .titles :global(.crumbs) { margin-block-start: var(--space-xs); }
</style>
