---
// "Waarom kiezen voor ons?": afgeronde kaart met vinkjes en knop.
import Section from "./Section.astro";
import LinkButton from "../LinkButton.astro";
import Icon from "../Icon.astro";
import type { Section as S } from "../../lib/sanity/queries";

type Props = Extract<S, { _type: "checklist" }>;
const { title, items, text, link, theme = "white" } = Astro.props;
---
<Section {theme}>
  <div class="wrapper">
    <div class="panel" data-tone="green" data-reveal>
      {title && <h2>{title}</h2>}
      <ul role="list" class="items">
        {items?.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}
      </ul>
      {text && <p class="cta-text">{text}</p>}
      <LinkButton {link} />
    </div>
  </div>
</Section>

<style>
  .panel {
    display: grid; justify-items: center; gap: var(--space-l);
    padding: var(--space-2xl) var(--space-m);
    border-radius: var(--radius);
    text-align: center;
  }
  h2 { color: var(--lemon); }
  .cta-text { color: var(--lemon); font-size: var(--step-1); margin-block-end: calc(var(--space-s) * -1); }
  .items { display: grid; gap: var(--space-s); text-align: start; font-size: var(--step-1); }
  .items li { display: grid; grid-template-columns: 1.5rem 1fr; gap: var(--space-xs); align-items: start; }
  .items svg { inline-size: 1.25rem; block-size: 1.25rem; margin-block-start: 0.2em; color: var(--lemon); }
</style>
