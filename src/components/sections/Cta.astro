---
// Call-to-action. Zonder foto: lemon kaart (Webflow layout-cta-green). Met foto: tekst naast beeld.
import Section from "./Section.astro";
import LinkButton from "../LinkButton.astro";
import SanityImg from "../SanityImg.astro";
import type { Section as S } from "../../lib/sanity/queries";

type Props = Omit<Extract<S, { _type: "cta" }>, "_key"> & { _key?: string };
const { title, text, link, image, theme = "white" } = Astro.props;
const hasImage = !!image?.asset;
---
<Section {theme}>
  <div class="wrapper">
    <div class:list={["panel", { "has-image": hasImage }]} data-tone={hasImage ? undefined : "lemon"} data-reveal>
      <div class="text">
        <h2>{title}</h2>
        {text && <p>{text}</p>}
        <LinkButton {link} />
      </div>
      {hasImage && <div class="media media-frame"><SanityImg {image} sizes="(min-width: 62rem) 40vw, 100vw" aspect={4 / 3} /></div>}
    </div>
  </div>
</Section>

<style>
  .panel { display: grid; gap: var(--space-l); align-items: center; border-radius: var(--radius); }
  .panel:not(.has-image) { padding: var(--space-xl) var(--space-l); }
  @media (min-width: 62rem) { .panel.has-image { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); } }
  .text { display: grid; gap: var(--space-s); justify-items: start; max-inline-size: 40rem; }
  h2 { font-size: var(--step-3); }
  .media { aspect-ratio: 4 / 3; }
</style>
