---
// Call-to-action. Zonder foto: lemon kaart (Webflow layout-cta-green). Met foto: tekst naast beeld.
import Section from "./Section.astro";
import LinkButton from "../LinkButton.astro";
import SanityImg from "../SanityImg.astro";
import type { Section as S } from "../../lib/sanity/queries";

type Props = Omit<Extract<S, { _type: "cta" }>, "_key"> & { _key?: string };
const { title, text, link, image, theme = "white" } = Astro.props;
const hasImage = !!image?.asset;
// *woord* → lemon-streep eronder (zoals in de hero)
const parts = title.split("*").map((text, i) => ({ text, highlight: i % 2 === 1 }));
---
<Section {theme}>
  <div class="wrapper">
    <div class:list={["panel", { "has-image": hasImage }]} data-tone={hasImage ? undefined : "lemon"} data-reveal>
      <div class="text">
        <h2>{parts.map((p) => (p.highlight ? <span class="highlight">{p.text}</span> : p.text))}</h2>
        {text && <p>{text}</p>}
        <LinkButton {link} />
      </div>
      {hasImage && <div class="media media-frame"><SanityImg {image} sizes="(min-width: 62rem) 40vw, 100vw" aspect={4 / 3} /></div>}
    </div>
  </div>
</Section>

<style>
  .panel { display: grid; gap: var(--space-l); align-items: center; border-radius: var(--radius); }
  /* Lemon-kaart zonder foto: gecentreerd, zoals live */
  .panel:not(.has-image) { padding: var(--space-xl) var(--space-l); justify-items: center; text-align: center; }
  .panel:not(.has-image) .text { justify-items: center; max-inline-size: 52rem; }
  .panel:not(.has-image) h2 { font-size: var(--step-4); }
  .panel:not(.has-image) p { max-inline-size: 46ch; font-size: var(--step--1); }
  @media (min-width: 62rem) { .panel.has-image { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); } }
  .text { display: grid; gap: var(--space-s); justify-items: start; max-inline-size: 40rem; }
  h2 { font-size: var(--step-3); }
  .has-image h2 { font-size: var(--step-4); }
  .media { aspect-ratio: 1; background: var(--sky); }
  .media :global(img) { object-fit: cover; object-position: bottom; }
</style>
