---
// Wrapper voor elke page-builder-sectie: thema + verticale ruimte.
import { stegaClean } from "@sanity/client/stega";
import type { Theme } from "../../lib/sanity/queries";
interface Props { theme?: Theme; class?: string; label?: string; id?: string }
const { theme = "white", class: className, label, id } = Astro.props;
---
<section class:list={["section", className]} data-theme={stegaClean(theme)} aria-label={label} id={id}>
  <slot />
</section>
