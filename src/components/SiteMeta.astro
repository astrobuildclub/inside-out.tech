---
// <head>: titel, beschrijving, canonical, Open Graph, JSON-LD. Zie ~/Code/_standards/SEO.md.
import { stegaClean } from "@sanity/client/stega";
import type { SiteSettings } from "../lib/sanity/settings";
import { urlFor, type SanityImage } from "../lib/sanity/image";
import { pageTitle, pageDescription, entityJsonLd, websiteJsonLd } from "../lib/seo";
import type { Seo } from "../lib/sanity/queries";

interface Props {
  settings: SiteSettings;
  title: string;
  seo?: Seo;
  fallbackDescription?: string;
  fallbackImage?: SanityImage;
  type?: "website" | "article";
  isHome?: boolean;
  noindex?: boolean;
  jsonLd?: object[];
}

// Stega-tekens horen niet in de <head> (alleen relevant in de Studio-preview).
const props = stegaClean(Astro.props);
const { settings, seo, type = "website", isHome = false, jsonLd = [] } = props;
const site = Astro.site!;

const title = pageTitle(settings, props.title, seo, isHome);
const description = pageDescription(settings, seo, props.fallbackDescription);
const noindex = settings.noindex || seo?.noindex || props.noindex;
const canonical = new URL(Astro.url.pathname, site).href;

// Deelafbeelding: seo.image → hoofdafbeelding → site-instellingen → /og-default.png
const image = [seo?.image, props.fallbackImage, settings.shareImage].find((i) => i?.asset) as SanityImage | undefined;
const ogImage = image
  ? urlFor(image).width(1200).height(630).fit("crop").format("jpg").url()
  : new URL("/og-default.png", site).href;

const structuredData = [entityJsonLd(settings, site), websiteJsonLd(settings, site), ...jsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.siteName} />
<meta property="og:locale" content="nl_NL" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{image?.alt && <meta property="og:image:alt" content={image.alt} />}
<meta name="twitter:card" content="summary_large_image" />

<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

{structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
