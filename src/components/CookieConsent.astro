---
// Laadt de cookie-consent (zie src/lib/consent.ts). Eén keer per sessie, de ClientRouter houdt hem vast.
interface Props { privacyHref?: string }
const { privacyHref = "/privacy" } = Astro.props;
---

<div data-consent-config data-privacy={privacyHref} hidden></div>

<script>
  import "vanilla-cookieconsent/dist/cookieconsent.css";
  import { initConsent, showPreferences, trackPageView } from "../lib/consent";

  let first = true;
  document.addEventListener("astro:page-load", () => {
    const privacy = document.querySelector<HTMLElement>("[data-consent-config]")?.dataset.privacy;
    initConsent(privacy);
    if (!first) trackPageView();
    first = false;
    document.querySelectorAll<HTMLButtonElement>("[data-cookie-preferences]").forEach((btn) => (btn.onclick = showPreferences));
  });
</script>

<style is:global>
  /* Consent-UI volgt de site-tokens. */
  #cc-main {
    --cc-font-family: var(--font-sans);
    --cc-bg: var(--color-bg);
    --cc-primary-color: var(--color-fg);
    --cc-secondary-color: var(--color-muted);
    --cc-btn-primary-bg: var(--lemon);
    --cc-btn-primary-color: var(--planet);
    --cc-btn-primary-border-color: var(--lemon);
    --cc-btn-primary-hover-bg: var(--planet);
    --cc-btn-primary-hover-color: var(--white);
    --cc-btn-primary-hover-border-color: var(--planet);
    --cc-btn-secondary-bg: var(--color-surface);
    --cc-btn-secondary-color: var(--color-fg);
    --cc-btn-secondary-border-color: var(--color-line);
    --cc-btn-secondary-hover-bg: var(--color-line);
    --cc-separator-border-color: var(--color-line);
    --cc-toggle-on-bg: var(--leaf);
    --cc-cookie-category-block-bg: var(--color-surface);
    --cc-cookie-category-block-border: var(--color-line);
    --cc-modal-border-radius: var(--radius);
    --cc-btn-border-radius: var(--radius-pill);
  }
</style>
