---
// Header: logo, hoofdmenu en contactknop. Onder 62rem opent het menu in een <dialog>
// (focus-trap, Esc en scroll-lock regelt de browser zelf).
import { stegaClean } from "@sanity/client/stega";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import LinkButton from "./LinkButton.astro";
import { linkHref, telHref } from "../lib/links";
import type { Navigation } from "../lib/sanity/queries";
import type { SiteSettings } from "../lib/sanity/settings";

interface Props { navigation: Navigation; settings: SiteSettings }
const { navigation, settings } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = (navigation.main ?? []).map((link) => {
  const href = linkHref(link);
  const clean = stegaClean(href);
  const current = !!clean && clean !== "/" && (path === clean || path.startsWith(`${clean}/`));
  return { link, href, current };
});
const a = settings.address;
---

<header class="site-header" data-theme="green">
  <div class="wrapper bar">
    <a href="/" class="home" aria-label={`${settings.siteName}, naar de homepage`}><Logo class="logo" /></a>

    <nav class="nav-inline" aria-label="Hoofdmenu">
      <ul role="list">
        {items.map(({ link, href, current }) => (
          <li><a href={href} aria-current={current ? "page" : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <LinkButton link={navigation.headerCta} style="secondary" arrow={false} class="cta" />
      <button type="button" class="menu-toggle" data-menu-open aria-haspopup="dialog">
        <Icon name="menu" /><span class="visually-hidden">Menu openen</span>
      </button>
    </div>
  </div>

  <dialog class="menu" data-menu aria-label="Menu" data-theme="green">
    <div class="wrapper menu-inner">
      <div class="menu-top">
        <a href="/" class="home" aria-label={`${settings.siteName}, naar de homepage`}><Logo class="logo" /></a>
        <button type="button" class="menu-toggle" data-menu-close autofocus>
          <Icon name="close" /><span class="visually-hidden">Menu sluiten</span>
        </button>
      </div>
      <nav aria-label="Hoofdmenu (mobiel)">
        <ul role="list" class="menu-links">
          {items.map(({ link, href, current }) => (
            <li><a href={href} aria-current={current ? "page" : undefined}>{link.label}</a></li>
          ))}
          {navigation.headerCta && <li><a href={linkHref(navigation.headerCta)}>{navigation.headerCta.label}</a></li>}
        </ul>
      </nav>
      <address class="menu-contact">
        {a?.street && <p>{a.street}<br />{a.postalCode} {a.city}</p>}
        {settings.telephone && <p><a href={telHref(settings.telephone)}>{settings.telephone}</a></p>}
        {settings.email && <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
      </address>
    </div>
  </dialog>
</header>

<script>
  // Menu-dialog: openen/sluiten, sluiten bij klik op een link of buiten het paneel.
  function init() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-menu]");
    if (!dialog) return;
    document.querySelectorAll<HTMLButtonElement>("[data-menu-open]").forEach((b) => (b.onclick = () => dialog.showModal()));
    dialog.querySelectorAll<HTMLButtonElement>("[data-menu-close]").forEach((b) => (b.onclick = () => dialog.close()));
    dialog.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => dialog.close()));
    // Groter dan het menu-breakpoint: dialog dicht, zodat hij niet blijft hangen.
    matchMedia("(min-width: 62rem)").addEventListener("change", (e) => e.matches && dialog.close());
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-block-end: 1px solid var(--color-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-block-size: 4.5rem;
  }
  .logo { inline-size: clamp(8.5rem, 12vw, 10.5rem); block-size: auto; color: var(--white); }
  .home { display: block; border-radius: 2px; }

  .nav-inline { display: none; margin-inline-start: auto; }
  .nav-inline ul { display: flex; gap: var(--space-m); }
  .nav-inline a, .menu-links a {
    text-decoration: none;
    font-weight: 500;
    background: linear-gradient(var(--lemon), var(--lemon)) no-repeat left bottom / 0 2px;
    transition: background-size var(--duration) var(--ease);
  }
  .nav-inline a { font-size: var(--step--1); padding-block: 0.4em; }
  .nav-inline a:hover, .nav-inline a[aria-current="page"],
  .menu-links a:hover, .menu-links a[aria-current="page"] { background-size: 100% 2px; }

  .actions { display: flex; align-items: center; gap: var(--space-xs); }
  .menu-toggle {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: var(--border-width) solid var(--lemon);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }

  @media (min-width: 62rem) {
    .nav-inline { display: block; }
    .actions .menu-toggle { display: none; }
  }
  @media (max-width: 30rem) {
    .actions :global(.cta) { display: none; }
  }

  .menu {
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .menu::backdrop { background: var(--planet); }
  .menu-inner { display: grid; gap: var(--space-xl); padding-block-end: var(--space-xl); }
  .menu-top { display: flex; justify-content: space-between; align-items: center; min-block-size: 4.5rem; }
  .menu-links { display: grid; gap: var(--space-2xs); font-size: var(--step-3); letter-spacing: var(--tracking-tight); }
  .menu-contact { font-style: normal; display: grid; gap: var(--space-xs); color: var(--color-muted); }
  .menu-contact a { color: var(--white); }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] { animation: menu-in var(--duration) var(--ease); }
    @keyframes menu-in { from { opacity: 0; translate: 0 -1rem; } }
  }
</style>
