---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import LinkButton from "./LinkButton.astro";
import { linkHref, telHref } from "../lib/links";
import { fileUrl } from "../lib/sanity/image";
import type { Navigation } from "../lib/sanity/queries";
import type { SiteSettings } from "../lib/sanity/settings";

interface Props { navigation: Navigation; settings: SiteSettings }
const { navigation, settings } = Astro.props;
const a = settings.address;
const socials = (settings.sameAs ?? []).map((url) => ({
  url,
  icon: url.includes("linkedin") ? ("linkedin" as const) : url.includes("instagram") ? ("instagram" as const) : undefined,
  label: url.includes("linkedin") ? "LinkedIn" : url.includes("instagram") ? "Instagram" : new URL(url).hostname,
}));
const termsUrl = fileUrl(navigation.terms ?? undefined);
const year = new Date().getFullYear();
---

<footer class="site-footer" data-tone="green">
  <div class="wrapper grid">
    <div class="about">
      <a href="/" class="home" aria-label={`${settings.siteName}, naar de homepage`}><Logo class="logo" /></a>
      <address>
        {settings.companyName && <p>{settings.companyName}</p>}
        {a?.street && <p>{a.street}<br />{a.postalCode} {a.city}</p>}
        <p>
          {settings.telephone && <a href={telHref(settings.telephone)}>{settings.telephone}</a>}
          {settings.telephone && settings.email && <br />}
          {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
        </p>
      </address>
      {socials.length > 0 && (
        <ul role="list" class="socials">
          {socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">
                {s.icon ? <Icon name={s.icon} /> : s.label}
                <span class="visually-hidden">{s.label} (opent in nieuw venster)</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="panel" data-tone="white">
      <nav aria-label="Footermenu">
        <ul role="list">
          {(navigation.footer ?? []).map((link) => <li><a href={linkHref(link)}>{link.label}</a></li>)}
        </ul>
      </nav>
      {(navigation.footerCtaText || navigation.footerCta) && (
        <div class="cta">
          {navigation.footerCtaText && <p>{navigation.footerCtaText}</p>}
          <LinkButton link={navigation.footerCta} style="primary" />
        </div>
      )}
      <div class="legal">
        <p>{year} © {settings.siteName} —</p>
        <ul role="list">
          {termsUrl && <li><a href={termsUrl} target="_blank" rel="noopener">{navigation.termsLabel ?? "Alg. voorwaarden"}</a></li>}
          {navigation.privacy && <li><a href={`/${navigation.privacy.slug}`}>{navigation.privacy.title}</a></li>}
          <li><button type="button" class="linklike" data-cookie-preferences>Cookie-instellingen</button></li>
          <li><a href="https://allthis.digital" target="_blank" rel="noopener">identity &amp; website by allthis.digital</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-2xl) var(--space-m); }
  .grid { display: grid; gap: var(--space-xl); }
  @media (min-width: 62rem) { .grid { grid-template-columns: 1fr minmax(0, 34rem); align-items: start; } }

  .home :global(.logo) { inline-size: 10.5rem; block-size: auto; color: var(--white); margin-block-end: var(--space-l); }
  .home { display: inline-block; }
  address { font-style: normal; display: grid; gap: var(--space-s); font-size: var(--step--1); }
  address a:hover { text-decoration-thickness: 2px; }
  .socials { display: flex; gap: var(--space-2xs); margin-block-start: var(--space-m); }
  .socials a {
    display: grid; place-items: center;
    inline-size: 2.75rem; block-size: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--lemon); color: var(--planet);
  }
  .socials svg { inline-size: 1.1rem; block-size: 1.1rem; }

  .panel {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
    padding: var(--space-m);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }
  @media (min-width: 36rem) { .panel { grid-template-columns: auto 1fr; } }
  .panel nav ul { display: grid; gap: 0.35em; }
  .panel nav a { text-decoration: none; }
  .panel nav a:hover { text-decoration: underline; }
  .cta { display: grid; gap: var(--space-m); align-content: start; font-size: var(--step-0); font-weight: 500; line-height: var(--leading-snug); }
  .cta :global(.button) { justify-self: start; }
  .legal {
    grid-column: 1 / -1;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25em 0.75em;
    font-size: 0.75rem;
  }
  .legal ul { display: contents; }
  /* "identity & website by …" rechts, zoals live */
  .legal li:last-child { margin-inline-start: auto; }
  .legal a, .linklike { color: inherit; text-decoration: none; }
  .legal a:hover, .linklike:hover { text-decoration: underline; }
  .linklike { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; }
</style>
