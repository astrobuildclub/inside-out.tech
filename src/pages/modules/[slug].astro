---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RichText from "../../components/RichText.astro";
import SanityImg from "../../components/SanityImg.astro";
import MediaGallery from "../../components/MediaGallery.astro";
import Cta from "../../components/sections/Cta.astro";
import { loadQuery } from "../../lib/sanity/load-query";
import { fileUrl } from "../../lib/sanity/image";
import { MODULE_QUERY, type Module } from "../../lib/sanity/queries";
import { breadcrumbJsonLd } from "../../lib/seo";

const { data: mod } = await loadQuery<Module | null>({ query: MODULE_QUERY, params: { slug: Astro.params.slug ?? "" } });
if (!mod) return Astro.rewrite("/404");

const factsheet = fileUrl(mod.factsheet ?? undefined);
const crumbs = [{ label: "Home", href: "/" }, { label: "Plug & Play", href: "/plug-play" }, { label: mod.title }];
---
<BaseLayout
  title={mod.title}
  seo={mod.seo}
  fallbackDescription={mod.intro ?? mod.excerpt}
  fallbackImage={mod.image}
  jsonLd={[breadcrumbJsonLd([{ name: "Plug & Play", path: "/plug-play" }, { name: mod.title, path: Astro.url.pathname }], Astro.site!)]}
>
  <section class="section intro-block" data-tone="light">
    <div class="wrapper head">
      {mod.image?.asset && <div class="media"><SanityImg image={mod.image} sizes="(min-width: 62rem) 45vw, 100vw" priority /></div>}
      <div class="titles">
        <h1>{mod.title}</h1>
        {mod.type && <p class="type">{mod.type}</p>}
        {mod.intro && <p class="intro">{mod.intro}</p>}
      </div>
    </div>
  </section>

  <section class="section" data-tone="white">
    <div class="wrapper detail">
      <div class="content">
        <RichText value={mod.content} />
      </div>
      {(mod.specs?.length || factsheet) && (
        <aside class="specs card" aria-labelledby="specs-title">
          <h2 id="specs-title">Specificaties</h2>
          <RichText value={mod.specs} />
          {factsheet && (
            <a class="button" data-style="primary" href={factsheet} target="_blank" rel="noopener">
              Download factsheet (PDF)<span class="visually-hidden"> (opent in nieuw venster)</span>
            </a>
          )}
        </aside>
      )}
    </div>
  </section>

  <MediaGallery media={mod.media} label={`Beelden van ${mod.title}`} />
  {mod.cta && <Cta {...mod.cta} />}
</BaseLayout>

<style>
  .detail { display: grid; gap: var(--space-xl); align-items: start; }
  @media (min-width: 62rem) { .detail { grid-template-columns: 6fr 4fr; gap: var(--space-2xl); } .specs { position: sticky; inset-block-start: 7rem; max-inline-size: 26rem; } }
  .content { display: grid; gap: var(--space-l); }
  .head { display: grid; gap: var(--space-xl); align-items: center; }
  @media (min-width: 62rem) { .head { grid-template-columns: 1fr 1fr; } }
  .head .media { aspect-ratio: 1; }
  .head .media :global(img) { inline-size: 100%; block-size: 100%; object-fit: contain; }
  .titles { display: grid; gap: var(--space-xs); }
  h1 { font-size: var(--step-4); }
  .type { color: var(--blue); font-weight: 700; font-size: var(--step--1); }
  .intro { max-inline-size: 48ch; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5em; font-size: var(--step--1); color: var(--color-muted); }
  .crumbs li + li::before { content: "›"; margin-inline-end: 0.5em; }
  .crumbs a { color: inherit; }
  /* Specificaties als blauwe kaart (live) */
  .specs { display: grid; gap: var(--space-s); padding: var(--space-m); justify-items: start; background: var(--blue); color: var(--white); }
  .specs h2 { font-size: var(--step-2); }
  .specs .button { --btn-bg: var(--lemon); --btn-fg: var(--planet); }
</style>
